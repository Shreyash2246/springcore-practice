<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Employee with Collections using Constructor Injection -->
    <bean class="com.springcore.CollectionInjection.usingConstructorInjection.employeeCollectionClass" name="emp2">
        
        <!-- Constructor arguments -->
        <constructor-arg value="Husaini Pathan"/>
        
        <!-- List as constructor argument -->
        <constructor-arg>
            <list>
                <value>1234567890</value>
                <value>0987654321</value>
            </list>
        </constructor-arg>
        
        <!-- Set as constructor argument -->
        <constructor-arg>
            <set>
                <value>Mumbai</value>
                <value>Delhi</value>
                <value>Bangalore</value>
            </set>
        </constructor-arg>
        
        <!-- Map as constructor argument -->
        <constructor-arg>
            <map>
                <entry key="React" value="1.5 Months"/>
                <entry key="Angular" value="2 Months"/>
            </map>
        </constructor-arg>
        
        <!-- Properties as constructor argument -->
        <constructor-arg>
            <props>
                <prop key="environment">production</prop>
                <prop key="version">1.0</prop>
            </props>
        </constructor-arg>
        
    </bean>

</beans>